{
  "openapi": "3.1.0",
  "info": {
    "title": "FORGE Mock Splunk",
    "description": "Read-only mock Splunk (/v1), plus reset and replay.",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/alerts": {
      "get": {
        "tags": [
          "splunk"
        ],
        "summary": "List Alerts",
        "operationId": "list_alerts",
        "parameters": [
          {
            "name": "after_seq",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "After Seq"
            }
          },
          {
            "name": "severity",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "critical"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Severity"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/alerts/{alert_id}": {
      "get": {
        "tags": [
          "splunk"
        ],
        "summary": "Get Alert",
        "operationId": "get_alert",
        "parameters": [
          {
            "name": "alert_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Alert Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Alert"
                }
              }
            }
          },
          "404": {
            "description": "Alert not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/alerts/{alert_id}/evidence": {
      "get": {
        "tags": [
          "splunk"
        ],
        "summary": "List Alert Evidence",
        "operationId": "list_alert_evidence",
        "parameters": [
          {
            "name": "alert_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Alert Id"
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Source"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceList"
                }
              }
            }
          },
          "404": {
            "description": "Alert not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/evidence": {
      "get": {
        "tags": [
          "splunk"
        ],
        "summary": "Query Evidence",
        "operationId": "query_evidence",
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "title": "Source"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "title": "Start"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "title": "End"
            }
          },
          {
            "name": "entity",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Entity"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceList"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sources": {
      "get": {
        "tags": [
          "splunk"
        ],
        "summary": "List Sources",
        "operationId": "list_sources",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceList"
                }
              }
            }
          }
        }
      }
    },
    "/v1/reset": {
      "post": {
        "tags": [
          "splunk"
        ],
        "summary": "Reset Fixtures",
        "operationId": "reset",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/replay": {
      "post": {
        "tags": [
          "splunk"
        ],
        "summary": "Replay Alert",
        "operationId": "replay",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplayRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Alert"
                }
              }
            }
          },
          "404": {
            "description": "Alert not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Healthz",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Alert": {
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Seq"
          },
          "alert_id": {
            "type": "string",
            "minLength": 1,
            "title": "Alert Id"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title"
          },
          "splunk_severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ],
            "title": "Splunk Severity"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "title": "Summary"
          },
          "rule_name": {
            "type": "string",
            "minLength": 1,
            "title": "Rule Name"
          },
          "mitre_techniques": {
            "items": {
              "type": "string",
              "pattern": "^T\\d{4}(\\.\\d{3})?$"
            },
            "type": "array",
            "title": "Mitre Techniques"
          },
          "triggered_at": {
            "type": "string",
            "title": "Triggered At"
          },
          "emitted_at": {
            "type": "string",
            "title": "Emitted At"
          },
          "replay_of": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Replay Of"
          },
          "entities": {
            "$ref": "#/components/schemas/Entities"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "seq",
          "alert_id",
          "title",
          "splunk_severity",
          "summary",
          "rule_name",
          "mitre_techniques",
          "triggered_at",
          "emitted_at",
          "entities"
        ],
        "title": "Alert"
      },
      "AlertPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Alert"
            },
            "type": "array",
            "title": "Items"
          },
          "next_after_seq": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Next After Seq"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "next_after_seq"
        ],
        "title": "AlertPage"
      },
      "Entities": {
        "properties": {
          "user": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User"
          },
          "src_ip": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Src Ip"
          },
          "src_country": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Src Country"
          },
          "hosts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Hosts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Entities"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "title": "ErrorResponse"
      },
      "EvidenceList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SplunkEvidence"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items"
        ],
        "title": "EvidenceList"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "ReplayRequest": {
        "properties": {
          "alert_id": {
            "type": "string",
            "minLength": 1,
            "title": "Alert Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "alert_id"
        ],
        "title": "ReplayRequest"
      },
      "ResetRequest": {
        "properties": {},
        "additionalProperties": false,
        "type": "object",
        "title": "ResetRequest",
        "description": "Empty JSON object. Extra fields are rejected."
      },
      "ResetResponse": {
        "properties": {
          "seed_version": {
            "type": "string",
            "title": "Seed Version"
          },
          "alerts": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Alerts"
          },
          "evidence": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Evidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "seed_version",
          "alerts",
          "evidence"
        ],
        "title": "ResetResponse"
      },
      "SourceList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SourceSummary"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items"
        ],
        "title": "SourceList"
      },
      "SourceSummary": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "id_prefix": {
            "type": "string",
            "title": "Id Prefix"
          },
          "record_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Record Count"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "id_prefix",
          "record_count"
        ],
        "title": "SourceSummary"
      },
      "SplunkEvidence": {
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^EV-[A-Z]+-\\d{4}$",
            "title": "Evidence Id"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "title": "Source"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "alert_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Alert Ids"
          },
          "entities": {
            "$ref": "#/components/schemas/Entities"
          },
          "content": {
            "additionalProperties": true,
            "type": "object",
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "evidence_id",
          "source",
          "timestamp",
          "alert_ids",
          "entities",
          "content"
        ],
        "title": "SplunkEvidence"
      }
    }
  }
}
