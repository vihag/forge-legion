server {
    listen ${GATEWAY_PORT};
    server_name _;

    location = /healthz {
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    location = /console {
        return 302 /console/;
    }

    location /console/ {
        alias /app/console/;
        index index.html;
    }

    location /case/ {
        proxy_pass http://${CASE_API_UPSTREAM}/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forge-Public "";
    }

    location /splunk/ {
        proxy_pass http://${MOCK_SPLUNK_UPSTREAM}/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forge-Public "";
    }

    location /soar/ {
        proxy_pass http://${MOCK_SOAR_UPSTREAM}/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forge-Public "";
    }

    location = /mcp/healthz {
        proxy_pass http://${MCP_UPSTREAM}/healthz;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forge-Public "";
    }

    location = /mcp {
        proxy_pass http://${MCP_UPSTREAM};
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forge-Public "";
    }

    location /mcp/ {
        proxy_pass http://${MCP_UPSTREAM};
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forge-Public "";
    }

    location = /mcp-analyst {
        proxy_pass http://${MCP_UPSTREAM};
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forge-Public "";
    }

    location /mcp-analyst/ {
        proxy_pass http://${MCP_UPSTREAM};
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forge-Public "";
    }

    location / {
        return 404;
    }
}

server {
    listen ${PUBLIC_GATEWAY_PORT};
    server_name _;

    location = /healthz {
        default_type application/json;
        add_header X-Forge-Public 1;
        return 200 '{"status":"ok"}';
    }

    location = /mcp/healthz {
        proxy_pass http://${MCP_UPSTREAM}/healthz;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forge-Public 1;
    }

    location = /mcp {
        proxy_pass http://${MCP_UPSTREAM};
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forge-Public 1;
    }

    location /mcp/ {
        proxy_pass http://${MCP_UPSTREAM};
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forge-Public 1;
    }

    location = /mcp-analyst {
        proxy_pass http://${MCP_UPSTREAM};
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forge-Public 1;
    }

    location /mcp-analyst/ {
        proxy_pass http://${MCP_UPSTREAM};
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forge-Public 1;
    }

    location / {
        add_header X-Forge-Public 1;
        return 404;
    }
}