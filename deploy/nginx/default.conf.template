server {
    listen ${GATEWAY_PORT};
    server_name _;

    # Re-resolve upstream names via Docker DNS so recreated containers (new IPs)
    # don't leave the gateway returning 502 until nginx restarts.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $case_upstream ${CASE_API_UPSTREAM};
    set $splunk_upstream ${MOCK_SPLUNK_UPSTREAM};
    set $soar_upstream ${MOCK_SOAR_UPSTREAM};
    set $mcp_upstream ${MCP_UPSTREAM};

    location = /healthz {
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    location = /console {
        return 302 /console/;
    }

    location /console/ {
        alias /app/console/;
        index index.html;
    }

    location /case/ {
        rewrite ^/case/(.*)$ /$1 break;
        proxy_pass http://$case_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forge-Public "";
    }

    location /splunk/ {
        rewrite ^/splunk/(.*)$ /$1 break;
        proxy_pass http://$splunk_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forge-Public "";
    }

    location /soar/ {
        rewrite ^/soar/(.*)$ /$1 break;
        proxy_pass http://$soar_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forge-Public "";
    }

    location = /mcp/healthz {
        proxy_pass http://$mcp_upstream/healthz;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forge-Public "";
    }

    location = /mcp {
        proxy_pass http://$mcp_upstream;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forge-Public "";
    }

    location /mcp/ {
        proxy_pass http://$mcp_upstream;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forge-Public "";
    }

    location = /mcp-analyst {
        proxy_pass http://$mcp_upstream;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forge-Public "";
    }

    location /mcp-analyst/ {
        proxy_pass http://$mcp_upstream;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forge-Public "";
    }

    location / {
        return 404;
    }
}

server {
    listen ${PUBLIC_GATEWAY_PORT};
    server_name _;

    # Re-resolve upstream names via Docker DNS so recreated containers (new IPs)
    # don't leave the gateway returning 502 until nginx restarts.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $case_upstream ${CASE_API_UPSTREAM};
    set $splunk_upstream ${MOCK_SPLUNK_UPSTREAM};
    set $soar_upstream ${MOCK_SOAR_UPSTREAM};
